# Copy these variable names into your cloud provider's environment settings.
# Do not commit a real DATABASE_URL or password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
PORT=3000

# Google Gemini free tier, used only by POST /api/explain. Leave GEMINI_API_KEY
# empty to run without it: explanations fall back to text assembled from the
# database rows, which is what the app shipped before. Do not commit a real key.
# Verify the current free-tier model ID in Google AI Studio before deploying —
# model IDs are retired over time.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
